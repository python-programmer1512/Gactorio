<mxfile host="Electron" agent="Codex">
  <diagram id="MEMENTO_PATTERN" name="Memento Pattern Diagram">
    <mxGraphModel dx="1935" dy="1132" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" value="Memento Pattern Diagram&#xa;Originator: Factory / CarbonationFactory / ConfigurableFactory&#xa;Memento: FactoryMemento tree&#xa;Caretaker: SimulationHistory&#xa;External access: FE SimControlPanel -&gt; Module.Controller -&gt; ctrl::Controller -&gt; FactoryController" vertex="1">
          <mxGeometry height="105" width="1280" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="pkg_external" parent="1" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#e1f5e6;strokeColor=#82b366;fontStyle=1" value="External Save / Undo Flow" vertex="1">
          <mxGeometry height="570" width="560" x="40" y="150" as="geometry" />
        </mxCell>
        <mxCell id="sim_panel" parent="pkg_external" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="SimControlPanel.js&#xa;&lt;&lt;FE View&gt;&gt;&#xa;--&#xa;#btn-save click -&gt; ctrl.saveCheckpoint()&#xa;#btn-undo click -&gt; ctrl.undo()&#xa;render():&#xa;  historySize()&#xa;  canUndo()&#xa;--&#xa;UI only sees Controller API, not memento internals." vertex="1">
          <mxGeometry height="200" width="245" x="25" y="60" as="geometry" />
        </mxCell>
        <mxCell id="module_controller" parent="pkg_external" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Module.Controller&#xa;&lt;&lt;embind proxy&gt;&gt;&#xa;--&#xa;+ saveCheckpoint()&#xa;+ undo() : bool&#xa;+ canUndo() : bool&#xa;+ historySize() : size_t&#xa;--&#xa;bound in src/web/bindings.cpp" vertex="1">
          <mxGeometry height="165" width="225" x="300" y="75" as="geometry" />
        </mxCell>
        <mxCell id="ctrl_controller" parent="pkg_external" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="ctrl::Controller&#xa;&lt;&lt;boundary adapter&gt;&gt;&#xa;--&#xa;+ saveCheckpoint()&#xa;+ undo() : bool&#xa;+ canUndo() const : bool&#xa;+ historySize() const : size_t&#xa;--&#xa;delegates to Impl.backend&#xa;marks cached FactoryView dirty after undo" vertex="1">
          <mxGeometry height="180" width="255" x="165" y="330" as="geometry" />
        </mxCell>
        <mxCell id="pkg_controller" parent="1" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#eef5ff;strokeColor=#6c8ebf;fontStyle=1" value="Controller / Caretaker" vertex="1">
          <mxGeometry height="570" width="600" x="650" y="150" as="geometry" />
        </mxCell>
        <mxCell id="factory_controller" parent="pkg_controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="FactoryController&#xa;&lt;&lt;facade&gt;&gt;&#xa;--&#xa;- factory : unique_ptr&lt;Factory&gt;&#xa;- history : SimulationHistory&#xa;--&#xa;+ saveCheckpoint()&#xa;  history.push(factory.createMemento())&#xa;+ undo() : bool&#xa;  m = history.pop()&#xa;  factory.restoreFromMemento(m)&#xa;+ canUndo() : bool&#xa;+ historySize() : size_t&#xa;--&#xa;public BE controller surface for checkpoints" vertex="1">
          <mxGeometry height="260" width="285" x="25" y="60" as="geometry" />
        </mxCell>
        <mxCell id="history" parent="pkg_controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="SimulationHistory&#xa;&lt;&lt;Caretaker&gt;&gt;&#xa;--&#xa;- snapshots : vector&lt;FactoryMemento&gt;&#xa;--&#xa;+ push(m : FactoryMemento)&#xa;+ pop() : optional&lt;FactoryMemento&gt;&#xa;+ canUndo() const : bool&#xa;+ clear()&#xa;+ size() const : size_t&#xa;--&#xa;LIFO stack&#xa;does not inspect memento contents" vertex="1">
          <mxGeometry height="220" width="220" x="350" y="85" as="geometry" />
        </mxCell>
        <mxCell id="snapshot_note" parent="pkg_controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Undo Semantics&#xa;--&#xa;saveCheckpoint pushes current FactoryMemento&#xa;undo pops latest checkpoint and restores it&#xa;no redo stack exists&#xa;statistics and event log are intentionally not restored" vertex="1">
          <mxGeometry height="115" width="385" x="95" y="385" as="geometry" />
        </mxCell>
        <mxCell id="pkg_originator" parent="1" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" value="Originator / Restored Model Objects" vertex="1">
          <mxGeometry height="570" width="760" x="1300" y="150" as="geometry" />
        </mxCell>
        <mxCell id="factory" parent="pkg_originator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Factory&#xa;&lt;&lt;Originator&gt;&gt;&#xa;--&#xa;- clock : SimClock&#xa;- inventory : Inventory&#xa;- productionLines : vector&lt;ProductionLine&gt;&#xa;--&#xa;+ createMemento() const : FactoryMemento&#xa;+ restoreFromMemento(m)&#xa;+ createProductById(id) : shared_ptr&lt;Product&gt;&#xa;+ createLineForMemento(line) : optional&lt;ProductionLine&gt;&#xa;--&#xa;captures time, inventory, lines, machines, queued tasks&#xa;restores topology and task/machine state" vertex="1">
          <mxGeometry height="255" width="305" x="25" y="55" as="geometry" />
        </mxCell>
        <mxCell id="factory_subclasses" parent="pkg_originator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Factory subclasses&#xa;--&#xa;CarbonationFactory&#xa;ConfigurableFactory&#xa;--&#xa;+ createMemento() override&#xa;+ restoreFromMemento(m) override&#xa;+ createProductById(id) override&#xa;+ createLineForMemento(line) override&#xa;--&#xa;preserve concrete product/line recreation rules" vertex="1">
          <mxGeometry height="205" width="285" x="375" y="55" as="geometry" />
        </mxCell>
        <mxCell id="line_task_machine" parent="pkg_originator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Restored objects&#xa;--&#xa;ProductionLine&#xa;  clearQueue(), enqueueTask()&#xa;  setScenario(), setQueueCapacity()&#xa;Machine&#xa;  restoreForMemento(health,status,progress,task)&#xa;ProductionTask&#xa;  restoreFromMemento(taskMemento)&#xa;Inventory&#xa;  replaceContents(items,products)&#xa;SimClock&#xa;  setNow(simulationTime)" vertex="1">
          <mxGeometry height="220" width="385" x="210" y="340" as="geometry" />
        </mxCell>
        <mxCell id="pkg_memento" parent="1" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" value="Memento Value Object Tree" vertex="1">
          <mxGeometry height="560" width="2020" x="40" y="770" as="geometry" />
        </mxCell>
        <mxCell id="factory_memento" parent="pkg_memento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="FactoryMemento&#xa;&lt;&lt;Memento root&gt;&gt;&#xa;--&#xa;- simulationTime : SimulationTime&#xa;- items : map&lt;string,int&gt;&#xa;- products : map&lt;ProductId,int&gt;&#xa;- lines : vector&lt;LineMemento&gt;&#xa;- nextLineId : LineId&#xa;- nextMachineId : MachineId&#xa;--&#xa;+ addLine(line)&#xa;+ setNextIds(lineId,machineId)" vertex="1">
          <mxGeometry height="225" width="275" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="line_memento" parent="pkg_memento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="LineMemento&#xa;--&#xa;- id : LineId&#xa;- queueProductIds : vector&lt;ProductId&gt;&#xa;- machines : vector&lt;MachineMemento&gt;&#xa;- scenario : ScenarioType&#xa;- queueCapacity : optional&lt;size_t&gt;&#xa;- droppedTaskCount : size_t&#xa;- tasks : vector&lt;ProductionTaskMemento&gt;&#xa;- definitionId : string&#xa;- displayName : string" vertex="1">
          <mxGeometry height="230" width="300" x="350" y="60" as="geometry" />
        </mxCell>
        <mxCell id="machine_memento" parent="pkg_memento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="MachineMemento&#xa;--&#xa;- id : MachineId&#xa;- health : double&#xa;- status : MachineStatus&#xa;- progress : double&#xa;- stationDefinitionId : string&#xa;- stationKind : string&#xa;- displayName : string&#xa;- typeName : string&#xa;- processingSpeed : double&#xa;- breakdownProbability : double&#xa;- assignedTaskIndex : optional&lt;size_t&gt;" vertex="1">
          <mxGeometry height="245" width="285" x="705" y="60" as="geometry" />
        </mxCell>
        <mxCell id="task_memento" parent="pkg_memento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="ProductionTaskMemento&#xa;--&#xa;- productId : ProductId&#xa;- recipeId : RecipeId&#xa;- currentStepIndex : size_t&#xa;- currentStepInputsConsumed : bool&#xa;- pendingStepOutputs : vector&lt;StepOutputMemento&gt;&#xa;--&#xa;preserves route progress and uncollected outputs" vertex="1">
          <mxGeometry height="175" width="285" x="1045" y="60" as="geometry" />
        </mxCell>
        <mxCell id="step_output_memento" parent="pkg_memento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="StepOutputMemento&#xa;--&#xa;- itemId : optional&lt;string&gt;&#xa;- productId : optional&lt;ProductId&gt;&#xa;- quantity : int&#xa;--&#xa;value copy of pending StepOutput" vertex="1">
          <mxGeometry height="135" width="250" x="1385" y="60" as="geometry" />
        </mxCell>
        <mxCell id="memento_scope" parent="pkg_memento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Captured Scope&#xa;--&#xa;simulation time&#xa;inventory raw items and products&#xa;line queue/task snapshots&#xa;line scenario/capacity/dropped count&#xa;machine health/status/progress/config IDs&#xa;next line/machine IDs&#xa;--&#xa;Not captured: statistics counters and event log." vertex="1">
          <mxGeometry height="185" width="285" x="1680" y="60" as="geometry" />
        </mxCell>
        <mxCell id="dto_separation" parent="pkg_memento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="DTO vs Memento Separation&#xa;--&#xa;FactorySnapshot / FactoryView: read-only UI state&#xa;FactoryMemento: restore payload for undo&#xa;DTOs copy model values for rendering&#xa;Mementos copy enough state to reconstruct simulation&#xa;Neither stores model pointers/references." vertex="1">
          <mxGeometry height="120" width="530" x="745" y="355" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;verticalAlign=top;fontSize=12" value="Legend&#xa;solid diamond: composition / value ownership&#xa;dashed arrow: facade/API call or create/restore dependency&#xa;open triangle: inheritance/generalization&#xa;Memento objects are value snapshots, treated as opaque by SimulationHistory." vertex="1">
          <mxGeometry height="120" width="520" x="1320" y="1350" as="geometry" />
