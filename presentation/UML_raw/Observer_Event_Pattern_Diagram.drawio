        <mxCell id="factory_snapshot" parent="pkg_dto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="FactorySnapshot&#xa;&lt;&lt;DTO aggregate&gt;&gt;&#xa;--&#xa;inventory : InventorySnapshot&#xa;statistics : StatisticsSnapshot&#xa;productionLines : vector&lt;ProductionLineSnapshot&gt;&#xa;events : vector&lt;EventSnapshot&gt;&#xa;--&#xa;BE snapshot payload" vertex="1">
