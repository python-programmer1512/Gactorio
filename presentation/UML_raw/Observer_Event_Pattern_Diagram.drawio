        <mxCell id="e_log_snapshot" value="maps Event -> EventSnapshot" style="endArrow=open;dashed=1;html=1;rounded=0;strokeColor=#b85450;fontSize=12" edge="1" parent="1" source="event_log_observer" target="event_snapshot">
