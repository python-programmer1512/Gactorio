        <mxCell id="e_factory_publish" value="publishes" style="endArrow=open;dashed=1;html=1;rounded=0;strokeColor=#d6b656;fontSize=12" edge="1" parent="1" source="factory" target="event_bus">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_event_to_log" value="onEvent stores Event" style="endArrow=open;dashed=1;html=1;rounded=0;strokeColor=#6c8ebf;fontSize=12" edge="1" parent="1" source="event" target="event_log_observer">
          <mxGeometry relative="1" as="geometry"/>
