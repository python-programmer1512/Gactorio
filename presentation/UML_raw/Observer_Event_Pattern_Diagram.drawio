<mxfile host="app.diagrams.net" modified="2026-06-14T13:25:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="OBSERVER_EVENT_PATTERN" name="Observer Event Pattern Diagram">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Observer / Event Pattern Diagram&#xa;Publishers -> EventBus Subject -> Observer subscribers -> DTO snapshots -> FE rendering&#xa;Factory owns EventBus and concrete observers; EventBus stores non-owning Observer* subscribers." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1250" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="pkg_publishers" value="Event Publishers / Model Sources" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="560" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="factory" value="Factory&#xa;&lt;&lt;owner / publisher&gt;&gt;&#xa;--&#xa;- eventBus : EventBus&#xa;- eventLog : EventLogObserver&#xa;- statistics : StatisticsObserver&#xa;--&#xa;constructor:&#xa;  eventBus.subscribe(&amp;eventLog)&#xa;  eventBus.subscribe(&amp;statistics)&#xa;--&#xa;publishes: Info / ProductCompleted / output events&#xa;exposes eventLog() and statistics()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_publishers">
          <mxGeometry x="25" y="55" width="250" height="245" as="geometry"/>
        </mxCell>
        <mxCell id="machine" value="Machine&#xa;&lt;&lt;publisher&gt;&gt;&#xa;--&#xa;- eventBus : EventBus*&#xa;--&#xa;publishes via publishEvent():&#xa;MachineBroken&#xa;MachineRepaired&#xa;StateChanged&#xa;StepCompleted&#xa;InputsConsumed&#xa;MachinePaused&#xa;--&#xa;sourceId = machine id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_publishers">
          <mxGeometry x="305" y="70" width="225" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="production_line" value="ProductionLine&#xa;&lt;&lt;publisher&gt;&gt;&#xa;--&#xa;- eventBus : EventBus*&#xa;--&#xa;publishes:&#xa;TaskEnqueued&#xa;TaskStarted&#xa;queue / overflow-related messages&#xa;--&#xa;sourceId = 0 for line-level events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_publishers">
          <mxGeometry x="25" y="355" width="250" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="event_type" value="EventType&#xa;&lt;&lt;enum&gt;&gt;&#xa;--&#xa;Info&#xa;TaskEnqueued&#xa;TaskStarted&#xa;StepCompleted&#xa;ProductCompleted&#xa;MachineBroken&#xa;MachineRepaired&#xa;StateChanged&#xa;InputsConsumed&#xa;MachinePaused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_publishers">
          <mxGeometry x="305" y="350" width="225" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="event" value="Event&#xa;&lt;&lt;immutable value&gt;&gt;&#xa;--&#xa;- simulationTime : SimulationTime&#xa;- type : EventType&#xa;- sourceId : MachineId&#xa;- message : string&#xa;--&#xa;+ simulationTime()&#xa;+ type()&#xa;+ sourceId()&#xa;+ message()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_publishers">
          <mxGeometry x="155" y="600" width="245" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="pkg_subject" value="Subject / Observer Core" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#eef5ff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="660" y="140" width="660" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="event_bus" value="EventBus&#xa;&lt;&lt;Subject&gt;&gt;&#xa;--&#xa;- observers : vector&lt;Observer*&gt;&#xa;--&#xa;+ subscribe(observer : Observer*)&#xa;+ publish(event : Event) const&#xa;--&#xa;fan-out to all subscribers&#xa;non-owning Observer* association" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_subject">
          <mxGeometry x="30" y="70" width="250" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="observer" value="&lt;&lt;abstract&gt;&gt;&#xa;Observer&#xa;--&#xa;+ virtual ~Observer()&#xa;+ onEvent(event : Event) = 0&#xa;--&#xa;GoF Observer subscriber role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13;fontStyle=2" vertex="1" parent="pkg_subject">
          <mxGeometry x="365" y="75" width="225" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="event_log_observer" value="EventLogObserver&#xa;&lt;&lt;Observer&gt;&gt;&#xa;--&#xa;- events : vector&lt;Event&gt;&#xa;--&#xa;+ onEvent(event) override&#xa;+ events() const : vector&lt;Event&gt;&amp;&#xa;+ clear()&#xa;--&#xa;stores chronological event log&#xa;alias: EventLog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_subject">
          <mxGeometry x="55" y="335" width="255" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="statistics_observer" value="StatisticsObserver&#xa;&lt;&lt;Observer&gt;&gt;&#xa;--&#xa;- completedProductEvents : int&#xa;- startedTaskEvents : int&#xa;- completedStepEvents : int&#xa;- brokenMachineEvents : int&#xa;- repairedMachineEvents : int&#xa;- stateChangedEvents : int&#xa;--&#xa;+ onEvent(event) override&#xa;+ counter getters&#xa;--&#xa;alias: Statistics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_subject">
          <mxGeometry x="365" y="300" width="255" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="observer_note" value="Subscription Lifetime&#xa;--&#xa;Factory owns EventBus, EventLogObserver, and StatisticsObserver.&#xa;EventBus only keeps Observer* and does not delete subscribers.&#xa;This is association, not composition from EventBus to observers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_subject">
          <mxGeometry x="105" y="610" width="450" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="pkg_dto" value="Controller DTO Conversion" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1380" y="140" width="680" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="factory_controller" value="FactoryController&#xa;&lt;&lt;DTO assembler&gt;&gt;&#xa;--&#xa;+ getEventLogs() : vector&lt;EventSnapshot&gt;&#xa;+ getStatistics() : StatisticsSnapshot&#xa;+ snapshot() : FactorySnapshot&#xa;+ clearEventLog()&#xa;--&#xa;reads Factory.eventLog().events()&#xa;reads Factory.statistics()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_dto">
          <mxGeometry x="25" y="60" width="265" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="event_snapshot" value="EventSnapshot&#xa;&lt;&lt;DTO&gt;&gt;&#xa;--&#xa;- simulationTime : SimulationTime&#xa;- type : EventType&#xa;- message : string&#xa;--&#xa;+ timeSeconds()&#xa;+ type()&#xa;+ message()&#xa;--&#xa;sourceId intentionally omitted from UI DTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_dto">
          <mxGeometry x="345" y="60" width="250" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="statistics_snapshot" value="StatisticsSnapshot&#xa;&lt;&lt;DTO&gt;&gt;&#xa;--&#xa;- completedProductEvents : int&#xa;- startedTaskEvents : int&#xa;- completedStepEvents : int&#xa;- brokenMachineEvents : int&#xa;- repairedMachineEvents : int&#xa;- stateChangedEvents : int&#xa;--&#xa;read-only copy of StatisticsObserver counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_dto">
          <mxGeometry x="345" y="285" width="250" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="factory_snapshot" value="FactorySnapshot&#xa;&lt;&lt;DTO aggregate&gt;&gt;&#xa;--&#xa;inventory : InventorySnapshot&#xa;statistics : StatisticsSnapshot&#xa;productionLines : vector&lt;ProductionLineSnapshot&gt;&#xa;events : vector&lt;EventSnapshot&gt;&#xa;--&#xa;BE snapshot payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_dto">
          <mxGeometry x="25" y="330" width="265" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="ctrl_controller" value="ctrl::Controller / Controller::Impl&#xa;&lt;&lt;FE boundary adapter&gt;&gt;&#xa;--&#xa;Impl::rebuild() maps:&#xa;FactorySnapshot.events -> EventView[]&#xa;FactorySnapshot.statistics -> Statistics&#xa;--&#xa;EventType converted to typeName string for JS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_dto">
          <mxGeometry x="25" y="555" width="300" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="fe_dtos" value="JS-visible DTOs&#xa;&lt;&lt;embind value_object&gt;&gt;&#xa;--&#xa;EventView { time, typeName, message }&#xa;Statistics { tasksStarted, stepsCompleted, productsDone, machinesBroken, machinesRepaired, stateChanges }&#xa;FactoryView { stats, events, ... }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_dto">
          <mxGeometry x="365" y="560" width="275" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="pkg_fe" value="Frontend Rendering" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="2020" height="370" as="geometry"/>
        </mxCell>
        <mxCell id="application" value="Application.js&#xa;--&#xa;ctrl.tick(dt)&#xa;toPlainSnapshot(ctrl.snapshot())&#xa;ui.renderAll(snapshot)&#xa;--&#xa;pulls FactoryView every render interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_fe">
          <mxGeometry x="25" y="60" width="260" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="event_log_panel" value="EventLogPanel.js&#xa;--&#xa;bind(): #btn-clear-log -> ctrl.clearEventLog()&#xa;render(snapshot):&#xa;  reverse snapshot.events&#xa;  show time, typeName, message&#xa;--&#xa;FE view of EventLogObserver data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_fe">
          <mxGeometry x="350" y="50" width="305" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="sim_control_panel" value="SimControlPanel.js&#xa;--&#xa;render(snapshot.stats):&#xa;tasksStarted&#xa;stepsCompleted&#xa;productsDone&#xa;machinesBroken&#xa;machinesRepaired&#xa;stateChanges&#xa;plus WIP/lost derived from lines&#xa;--&#xa;FE view of StatisticsObserver data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" vertex="1" parent="pkg_fe">
          <mxGeometry x="720" y="50" width="310" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="wasm_boundary" value="src/web/bindings.cpp&#xa;--&#xa;value_object&lt;EventView&gt;&#xa;register_vector&lt;EventView&gt;&#xa;value_object&lt;Statistics&gt;&#xa;value_object&lt;FactoryView&gt;&#xa;function clearEventLog()&#xa;function snapshot()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=13;dashed=1" vertex="1" parent="pkg_fe">
          <mxGeometry x="1095" y="50" width="285" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="Legend&#xa;solid diamond: owning composition&#xa;open diamond: non-owning aggregation/association&#xa;open triangle: Observer inheritance&#xa;dashed arrow: publish/DTO conversion/render dependency&#xa;EventBus does not own observers; Factory does." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;verticalAlign=top;fontSize=12" vertex="1" parent="pkg_fe">
          <mxGeometry x="1450" y="60" width="500" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="e_factory_bus_own" value="owns" style="endArrow=diamondThin;endFill=1;html=1;rounded=0;strokeColor=#d6b656;fontSize=12" edge="1" parent="1" source="factory" target="event_bus">
