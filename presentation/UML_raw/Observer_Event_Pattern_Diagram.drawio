        <mxCell id="e_machine_publish" value="publishes" style="endArrow=open;dashed=1;html=1;rounded=0;strokeColor=#d6b656;fontSize=12" edge="1" parent="1" source="machine" target="event_bus">
          <mxGeometry relative="1" as="geometry"/>
