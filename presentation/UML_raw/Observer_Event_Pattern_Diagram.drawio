<mxfile host="Electron" agent="Codex">
  <diagram id="OBSERVER_EVENT_PATTERN" name="Observer Event Pattern Diagram">
    <mxGraphModel dx="2350" dy="1374" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" value="Observer / Event Pattern Diagram&#xa;Publishers -&gt; EventBus Subject -&gt; Observer subscribers -&gt; DTO snapshots -&gt; FE rendering&#xa;Factory owns EventBus and concrete observers; EventBus stores non-owning Observer* subscribers." vertex="1">
          <mxGeometry height="95" width="1250" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="pkg_publishers" parent="1" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" value="Event Publishers / Model Sources" vertex="1">
          <mxGeometry height="760" width="560" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="factory" parent="pkg_publishers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Factory&#xa;&lt;&lt;owner / publisher&gt;&gt;&#xa;--&#xa;- eventBus : EventBus&#xa;- eventLog : EventLogObserver&#xa;- statistics : StatisticsObserver&#xa;--&#xa;constructor:&#xa;  eventBus.subscribe(&amp;eventLog)&#xa;  eventBus.subscribe(&amp;statistics)&#xa;--&#xa;publishes: Info / ProductCompleted / output events&#xa;exposes eventLog() and statistics()" vertex="1">
          <mxGeometry height="245" width="250" x="25" y="55" as="geometry" />
        </mxCell>
        <mxCell id="machine" parent="pkg_publishers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Machine&#xa;&lt;&lt;publisher&gt;&gt;&#xa;--&#xa;- eventBus : EventBus*&#xa;--&#xa;publishes via publishEvent():&#xa;MachineBroken&#xa;MachineRepaired&#xa;StateChanged&#xa;StepCompleted&#xa;InputsConsumed&#xa;MachinePaused&#xa;--&#xa;sourceId = machine id" vertex="1">
          <mxGeometry height="235" width="225" x="320" y="55" as="geometry" />
        </mxCell>
        <mxCell id="production_line" parent="pkg_publishers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="ProductionLine&#xa;&lt;&lt;publisher&gt;&gt;&#xa;--&#xa;- eventBus : EventBus*&#xa;--&#xa;publishes:&#xa;TaskEnqueued&#xa;TaskStarted&#xa;queue / overflow-related messages&#xa;--&#xa;sourceId = 0 for line-level events" vertex="1">
          <mxGeometry height="175" width="250" x="25" y="355" as="geometry" />
        </mxCell>
        <mxCell id="event_type" parent="pkg_publishers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="EventType&#xa;&lt;&lt;enum&gt;&gt;&#xa;--&#xa;Info&#xa;TaskEnqueued&#xa;TaskStarted&#xa;StepCompleted&#xa;ProductCompleted&#xa;MachineBroken&#xa;MachineRepaired&#xa;StateChanged&#xa;InputsConsumed&#xa;MachinePaused" vertex="1">
          <mxGeometry height="215" width="225" x="305" y="350" as="geometry" />
        </mxCell>
        <mxCell id="event" parent="pkg_publishers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Event&#xa;&lt;&lt;immutable value&gt;&gt;&#xa;--&#xa;- simulationTime : SimulationTime&#xa;- type : EventType&#xa;- sourceId : MachineId&#xa;- message : string&#xa;--&#xa;+ simulationTime()&#xa;+ type()&#xa;+ sourceId()&#xa;+ message()" vertex="1">
          <mxGeometry height="200" width="245" x="20" y="550" as="geometry" />
        </mxCell>
        <mxCell id="pkg_subject" parent="1" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#eef5ff;strokeColor=#6c8ebf;fontStyle=1" value="Subject / Observer Core" vertex="1">
          <mxGeometry height="760" width="660" x="660" y="140" as="geometry" />
        </mxCell>
        <mxCell id="event_bus" parent="pkg_subject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="EventBus&#xa;&lt;&lt;Subject&gt;&gt;&#xa;--&#xa;- observers : vector&lt;Observer*&gt;&#xa;--&#xa;+ subscribe(observer : Observer*)&#xa;+ publish(event : Event) const&#xa;--&#xa;fan-out to all subscribers&#xa;non-owning Observer* association" vertex="1">
          <mxGeometry height="180" width="250" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="observer" parent="pkg_subject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13;fontStyle=2" value="&lt;&lt;abstract&gt;&gt;&#xa;Observer&#xa;--&#xa;+ virtual ~Observer()&#xa;+ onEvent(event : Event) = 0&#xa;--&#xa;GoF Observer subscriber role" vertex="1">
          <mxGeometry height="130" width="225" x="365" y="75" as="geometry" />
        </mxCell>
        <mxCell id="event_log_observer" parent="pkg_subject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="EventLogObserver&#xa;&lt;&lt;Observer&gt;&gt;&#xa;--&#xa;- events : vector&lt;Event&gt;&#xa;--&#xa;+ onEvent(event) override&#xa;+ events() const : vector&lt;Event&gt;&amp;&#xa;+ clear()&#xa;--&#xa;stores chronological event log&#xa;alias: EventLog" vertex="1">
          <mxGeometry height="185" width="255" x="55" y="335" as="geometry" />
        </mxCell>
        <mxCell id="statistics_observer" parent="pkg_subject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="StatisticsObserver&#xa;&lt;&lt;Observer&gt;&gt;&#xa;--&#xa;- completedProductEvents : int&#xa;- startedTaskEvents : int&#xa;- completedStepEvents : int&#xa;- brokenMachineEvents : int&#xa;- repairedMachineEvents : int&#xa;- stateChangedEvents : int&#xa;--&#xa;+ onEvent(event) override&#xa;+ counter getters&#xa;--&#xa;alias: Statistics" vertex="1">
          <mxGeometry height="230" width="255" x="365" y="300" as="geometry" />
        </mxCell>
        <mxCell id="observer_note" parent="pkg_subject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="Subscription Lifetime&#xa;--&#xa;Factory owns EventBus, EventLogObserver, and StatisticsObserver.&#xa;EventBus only keeps Observer* and does not delete subscribers.&#xa;This is association, not composition from EventBus to observers." vertex="1">
          <mxGeometry height="95" width="450" x="105" y="610" as="geometry" />
        </mxCell>
        <mxCell id="pkg_dto" parent="1" style="swimlane;html=1;startSize=34;rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" value="Controller DTO Conversion" vertex="1">
          <mxGeometry height="760" width="680" x="1380" y="140" as="geometry" />
        </mxCell>
        <mxCell id="factory_controller" parent="pkg_dto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="FactoryController&#xa;&lt;&lt;DTO assembler&gt;&gt;&#xa;--&#xa;+ getEventLogs() : vector&lt;EventSnapshot&gt;&#xa;+ getStatistics() : StatisticsSnapshot&#xa;+ snapshot() : FactorySnapshot&#xa;+ clearEventLog()&#xa;--&#xa;reads Factory.eventLog().events()&#xa;reads Factory.statistics()" vertex="1">
          <mxGeometry height="190" width="265" x="25" y="60" as="geometry" />
        </mxCell>
        <mxCell id="event_snapshot" parent="pkg_dto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="EventSnapshot&#xa;&lt;&lt;DTO&gt;&gt;&#xa;--&#xa;- simulationTime : SimulationTime&#xa;- type : EventType&#xa;- message : string&#xa;--&#xa;+ timeSeconds()&#xa;+ type()&#xa;+ message()&#xa;--&#xa;sourceId intentionally omitted from UI DTO" vertex="1">
          <mxGeometry height="220" width="250" x="345" y="60" as="geometry" />
        </mxCell>
        <mxCell id="statistics_snapshot" parent="pkg_dto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=13" value="StatisticsSnapshot&#xa;&lt;&lt;DTO&gt;&gt;&#xa;--&#xa;- completedProductEvents : int&#xa;- startedTaskEvents : int&#xa;- completedStepEvents : int&#xa;- brokenMachineEvents : int&#xa;- repairedMachineEvents : int&#xa;- stateChangedEvents : int&#xa;--&#xa;read-only copy of StatisticsObserver counters" vertex="1">
